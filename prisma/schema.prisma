generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  SALES
  STOCK_MANAGER
  ACCOUNTANT
  HR
  WAREHOUSE
  READ_ONLY
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum DocumentType {
  QUOTE
  INVOICE
  PROFORMA
  CREDIT_NOTE
  PURCHASE_ORDER
  DELIVERY_NOTE
  RECEIPT
}

enum DocumentStatus {
  DRAFT
  SENT
  ACCEPTED
  REFUSED
  PAID
  PARTIALLY_PAID
  OVERDUE
}

enum PaymentMode {
  CASH
  CHECK
  TRANSFER
  CARD
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum InventoryMovementType {
  RECEIPT
  ISSUE
  TRANSFER
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RESERVATION
  RELEASE
}

enum InventoryMovementStatus {
  DRAFT
  POSTED
  CANCELLED
}

model Company {
  id                           String                               @id @default(cuid())
  name                         String
  ice                          String?
  taxId                        String?
  rc                           String?
  phone                        String?
  email                        String?
  address                      String?
  city                         String?
  logoUrl                      String?
  stampUrl                     String?
  signUrl                      String?
  users                        User[]
  clients                      Client[]
  suppliers                    Supplier[]
  products                     Product[]
  productCategories            ProductCategory[]
  documents                    Document[]
  deliveryNotes                DeliveryNote[]
  purchases                    PurchaseInvoice[]
  cashEntries                  CashEntry[]
  employees                    Employee[]
  employeeContracts            EmployeeContract[]
  attendances                  Attendance[]
  hrLeaves                     HrLeave[]
  salarySlips                  SalarySlip[]
  salaryAdvances               SalaryAdvance[]
  hrDocuments                  HrDocument[]
  expenses                     Expense[]
  categories                   Category[]
  movements                    StockMovement[]
  crmCompanies                 CrmCompany[]
  crmCustomers                 CrmCustomer[]
  crmContacts                  CrmContact[]
  crmMeetings                  CrmMeeting[]
  crmTasks                     CrmTask[]
  crmNotes                     CrmNote[]
  salesQuotes                  SalesQuote[]
  salesOrders                  SalesOrder[]
  salesDeliveryNotes           SalesDeliveryNote[]
  salesShipments               SalesShipment[]
  salesInvoices                SalesInvoice[]
  salesPayments                SalesPayment[]
  procurementSuppliers         ProcurementSupplier[]
  procurementPurchaseOrders    ProcurementPurchaseOrder[]
  procurementGoodsReceipts     ProcurementGoodsReceipt[]
  procurementSupplierBills     ProcurementSupplierBill[]
  procurementSupplierPayments  ProcurementSupplierPayment[]
  accountingAccounts           AccountingAccount[]
  accountingJournals           AccountingJournal[]
  accountingJournalEntries     AccountingJournalEntry[]
  accountingPeriods            AccountingPeriod[]
  accountingCommercialSettings AccountingCommercialPostingSettings?
  accountingApSettings         AccountingApPostingSettings?
  accountingInventorySettings  AccountingInventoryPostingSettings?
  hrEmployees                  HrEmployee[]
  hrDepartments                HrDepartment[]
  hrPositions                  HrPosition[]
  hrEmploymentContracts        HrEmploymentContract[]
  hrLeaveTypes                 HrLeaveType[]
  hrLeaveRequests              HrLeaveRequest[]
  inventoryWarehouses          InventoryWarehouse[]
  inventoryBalances            InventoryBalance[]
  inventoryMovements           InventoryStockMovement[]
  inventoryValuationEvents     InventoryValuationEvent[]
  createdAt                    DateTime                             @default(now())
  updatedAt                    DateTime                             @updatedAt
}

model User {
  id           String       @id @default(cuid())
  companyId    String?
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  email        String       @unique
  passwordHash String
  role         Role         @default(READ_ONLY)
  status       UserStatus   @default(ACTIVE)
  hrEmployees  HrEmployee[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([companyId])
  @@index([companyId, status])
}

model Client {
  id            String         @id @default(cuid())
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  contactName   String?
  ice           String?
  taxId         String?
  rc            String?
  phone         String?
  email         String?
  address       String?
  city          String?
  balance       Decimal        @default(0)
  documents     Document[]
  deliveryNotes DeliveryNote[]
  reminders     Reminder[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([companyId])
  @@index([companyId, ice])
}

model Supplier {
  id          String            @id @default(cuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  contactName String?
  ice         String?
  taxId       String?
  rc          String?
  phone       String?
  email       String?
  address     String?
  city        String?
  balance     Decimal           @default(0)
  purchases   PurchaseInvoice[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([companyId])
  @@index([companyId, ice])
}

model Category {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  products  Product[]
  createdAt DateTime  @default(now())

  @@unique([companyId, name])
  @@index([companyId])
}

model ProductCategory {
  id          String            @id @default(cuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  parentId    String?
  parent      ProductCategory?  @relation("ProductCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    ProductCategory[] @relation("ProductCategoryTree")
  description String?
  order       Int               @default(0)
  active      Boolean           @default(true)
  products    Product[]         @relation("ProductCatalogCategory")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@index([companyId, active])
  @@index([parentId])
}

model Product {
  id                            String                         @id @default(cuid())
  companyId                     String
  company                       Company                        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categoryId                    String?
  category                      Category?                      @relation(fields: [categoryId], references: [id])
  productCategoryId             String?
  productCategory               ProductCategory?               @relation("ProductCatalogCategory", fields: [productCategoryId], references: [id], onDelete: SetNull)
  sku                           String
  barcode                       String?
  reference                     String
  name                          String
  designation                   String
  shortDescription              String?
  description                   String?
  brand                         String?
  unit                          String                         @default("piece")
  imageUrl                      String?
  purchasePrice                 Decimal                        @default(0)
  sellingPrice                  Decimal
  salePrice                     Decimal
  vatRate                       Decimal                        @default(20)
  currency                      String                         @default("MAD")
  reorderPoint                  Decimal                        @default(0)
  active                        Boolean                        @default(true)
  status                        String                         @default("active")
  notes                         String?
  trackInventory                Boolean                        @default(false)
  allowNegativeStock            Boolean                        @default(false)
  hasVariants                   Boolean                        @default(false)
  serialTracked                 Boolean                        @default(false)
  batchTracked                  Boolean                        @default(false)
  stock                         Int                            @default(0)
  minStock                      Int                            @default(0)
  lines                         DocumentLine[]
  deliveryLines                 DeliveryNoteLine[]
  purchaseLines                 PurchaseInvoiceLine[]
  procurementPurchaseOrderLines ProcurementPurchaseOrderLine[]
  procurementGoodsReceiptLines  ProcurementGoodsReceiptLine[]
  movements                     StockMovement[]
  inventoryBalances             InventoryBalance[]
  inventoryMovements            InventoryStockMovement[]
  inventoryValuationEvents      InventoryValuationEvent[]
  salesQuoteLines               SalesQuoteLine[]
  salesOrderLines               SalesOrderLine[]
  salesDeliveryNoteLines        SalesDeliveryNoteLine[]
  salesShipmentLines            SalesShipmentLine[]
  salesInvoiceLines             SalesInvoiceLine[]
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  procurementSupplierBillLines  ProcurementSupplierBillLine[]

  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@unique([companyId, reference])
  @@index([companyId])
  @@index([companyId, active])
  @@index([companyId, status])
  @@index([productCategoryId])
}

model Document {
  id         String         @id @default(cuid())
  companyId  String
  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId   String?
  client     Client?        @relation(fields: [clientId], references: [id])
  type       DocumentType
  status     DocumentStatus @default(DRAFT)
  number     String
  issueDate  DateTime       @default(now())
  dueDate    DateTime?
  subtotal   Decimal        @default(0)
  vatTotal   Decimal        @default(0)
  total      Decimal        @default(0)
  paidAmount Decimal        @default(0)
  notes      String?
  lines      DocumentLine[]
  payments   Payment[]
  sourceId   String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([companyId, type, number])
  @@index([companyId, status])
  @@index([companyId, clientId])
  @@index([companyId, clientId, type])
}

model DocumentLine {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  designation String
  quantity    Decimal
  unitPrice   Decimal
  vatRate     Decimal
  total       Decimal
}

model Payment {
  id         String      @id @default(cuid())
  documentId String
  document   Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  amount     Decimal
  mode       PaymentMode
  reference  String?
  paidAt     DateTime    @default(now())
}

model DeliveryNote {
  id                String             @id @default(cuid())
  companyId         String
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId          String
  client            Client             @relation(fields: [clientId], references: [id])
  number            String
  status            DocumentStatus     @default(DRAFT)
  issueDate         DateTime           @default(now())
  internalReference String?
  deliveryAddress   String?
  city              String?
  deliveryTerms     String?
  internalNotes     String?
  lines             DeliveryNoteLine[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([companyId, number])
  @@index([companyId, clientId])
  @@index([companyId, status])
}

model DeliveryNoteLine {
  id                String       @id @default(cuid())
  deliveryNoteId    String
  deliveryNote      DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?     @relation(fields: [productId], references: [id])
  reference         String?
  designation       String
  orderedQuantity   Decimal
  deliveredQuantity Decimal
  unit              String       @default("Pièce")
  observations      String?
}

model PurchaseInvoice {
  id         String                @id @default(cuid())
  companyId  String
  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier              @relation(fields: [supplierId], references: [id])
  number     String
  status     DocumentStatus        @default(DRAFT)
  issueDate  DateTime              @default(now())
  dueDate    DateTime?
  subtotal   Decimal               @default(0)
  vatTotal   Decimal               @default(0)
  total      Decimal               @default(0)
  paidAmount Decimal               @default(0)
  notes      String?
  lines      PurchaseInvoiceLine[]
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@unique([companyId, number])
  @@index([companyId, supplierId])
  @@index([companyId, status])
}

model PurchaseInvoiceLine {
  id                String          @id @default(cuid())
  purchaseInvoiceId String
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?        @relation(fields: [productId], references: [id])
  designation       String
  quantity          Decimal
  unitPrice         Decimal
  vatRate           Decimal
  total             Decimal
}

model CashEntry {
  id        String      @id @default(cuid())
  companyId String
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type      String
  category  String
  label     String
  amount    Decimal
  mode      PaymentMode
  reference String?
  entryDate DateTime    @default(now())
  createdAt DateTime    @default(now())

  @@index([companyId, entryDate])
  @@index([companyId, type])
}

model Expense {
  id        String      @id @default(cuid())
  companyId String
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  label     String
  amount    Decimal
  mode      PaymentMode
  spentAt   DateTime    @default(now())
  createdAt DateTime    @default(now())

  @@index([companyId])
}

model Employee {
  id           String             @id @default(cuid())
  companyId    String
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  photoUrl     String?
  firstName    String
  lastName     String
  cin          String
  phone        String?
  email        String?
  address      String?
  city         String?
  birthDate    DateTime?
  hireDate     DateTime
  position     String
  department   String
  contractType String
  baseSalary   Decimal            @default(0)
  status       String             @default("actif")
  contracts    EmployeeContract[]
  attendances  Attendance[]
  leaves       HrLeave[]
  salarySlips  SalarySlip[]
  advances     SalaryAdvance[]
  documents    HrDocument[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, cin])
}

model EmployeeContract {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type          String
  startDate     DateTime
  endDate       DateTime?
  salary        Decimal   @default(0)
  position      String
  signedFileUrl String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId, employeeId])
  @@index([companyId, type])
}

model Attendance {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDate    DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  lateMinutes Int       @default(0)
  workedHours Decimal   @default(0)
  createdAt   DateTime  @default(now())

  @@index([companyId, employeeId])
  @@index([companyId, workDate])
}

model HrLeave {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       String
  reason     String
  startDate  DateTime
  endDate    DateTime
  days       Decimal  @default(0)
  status     String   @default("en attente")
  balance    Decimal  @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId, employeeId])
  @@index([companyId, status])
}

model SalarySlip {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month          String
  baseSalary     Decimal   @default(0)
  bonuses        Decimal   @default(0)
  advances       Decimal   @default(0)
  deductions     Decimal   @default(0)
  unpaidAbsences Decimal   @default(0)
  netSalary      Decimal   @default(0)
  paidAt         DateTime?
  createdAt      DateTime  @default(now())

  @@unique([companyId, employeeId, month])
  @@index([companyId, month])
}

model SalaryAdvance {
  id         String      @id @default(cuid())
  companyId  String
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount     Decimal
  mode       PaymentMode
  paidAt     DateTime    @default(now())
  deducted   Boolean     @default(false)
  createdAt  DateTime    @default(now())

  @@index([companyId, employeeId])
  @@index([companyId, paidAt])
}

model HrDocument {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       String
  title      String
  fileUrl    String?
  issuedAt   DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([companyId, employeeId])
  @@index([companyId, type])
}

model HrDepartment {
  id              String       @id
  tenantCompanyId String
  tenantCompany   Company      @relation(fields: [tenantCompanyId], references: [id], onDelete: Cascade)
  code            String?
  name            String
  description     String?
  managerId       String?
  manager         HrEmployee?  @relation("HrDepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  active          Boolean      @default(true)
  employees       HrEmployee[]
  positions       HrPosition[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([tenantCompanyId, name])
  @@index([tenantCompanyId, active])
  @@index([tenantCompanyId, managerId])
}

model HrPosition {
  id              String                 @id
  tenantCompanyId String
  tenantCompany   Company                @relation(fields: [tenantCompanyId], references: [id], onDelete: Cascade)
  code            String?
  name            String
  departmentId    String?
  department      HrDepartment?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  description     String?
  active          Boolean                @default(true)
  employees       HrEmployee[]
  contracts       HrEmploymentContract[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([tenantCompanyId, name])
  @@index([tenantCompanyId, departmentId])
  @@index([tenantCompanyId, active])
}

model HrEmployee {
  id                    String                 @id
  tenantCompanyId       String
  tenantCompany         Company                @relation(fields: [tenantCompanyId], references: [id], onDelete: Cascade)
  employeeNumber        String
  firstName             String
  lastName              String
  displayName           String
  email                 String?
  phone                 String?
  dateOfBirth           DateTime?
  hireDate              DateTime
  terminationDate       DateTime?
  status                String                 @default("active")
  departmentId          String?
  department            HrDepartment?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  positionId            String?
  position              HrPosition?            @relation(fields: [positionId], references: [id], onDelete: SetNull)
  managerEmployeeId     String?
  manager               HrEmployee?            @relation("HrEmployeeManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  directReports         HrEmployee[]           @relation("HrEmployeeManager")
  managedDepartments    HrDepartment[]         @relation("HrDepartmentManager")
  linkedUserId          String?
  linkedUser            User?                  @relation(fields: [linkedUserId], references: [id], onDelete: SetNull)
  notes                 String?
  contracts             HrEmploymentContract[]
  leaveRequests         HrLeaveRequest[]
  approvedLeaveRequests HrLeaveRequest[]       @relation("HrLeaveApprover")
  archivedAt            DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([tenantCompanyId, employeeNumber])
  @@unique([tenantCompanyId, linkedUserId])
  @@index([tenantCompanyId, status])
  @@index([tenantCompanyId, departmentId])
  @@index([tenantCompanyId, positionId])
  @@index([tenantCompanyId, managerEmployeeId])
}

model HrEmploymentContract {
  id              String      @id
  tenantCompanyId String
  tenantCompany   Company     @relation(fields: [tenantCompanyId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        HrEmployee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  contractType    String
  startDate       DateTime
  endDate         DateTime?
  positionId      String?
  position        HrPosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  jobTitle        String
  workingTimeType String?
  notes           String?
  status          String      @default("active")
  archivedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([tenantCompanyId, employeeId])
  @@index([tenantCompanyId, status])
  @@index([tenantCompanyId, positionId])
}

model HrLeaveType {
  id              String           @id
  tenantCompanyId String
  tenantCompany   Company          @relation(fields: [tenantCompanyId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  paid            Boolean          @default(true)
  active          Boolean          @default(true)
  leaveRequests   HrLeaveRequest[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([tenantCompanyId, name])
  @@index([tenantCompanyId, active])
}

model HrLeaveRequest {
  id                   String       @id
  tenantCompanyId      String
  tenantCompany        Company      @relation(fields: [tenantCompanyId], references: [id], onDelete: Cascade)
  employeeId           String
  employee             HrEmployee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId          String?
  leaveType            HrLeaveType? @relation(fields: [leaveTypeId], references: [id], onDelete: SetNull)
  title                String
  reason               String?
  startDate            DateTime
  endDate              DateTime
  status               String       @default("requested")
  requestedAt          DateTime
  approvedAt           DateTime?
  approvedByEmployeeId String?
  approvedByEmployee   HrEmployee?  @relation("HrLeaveApprover", fields: [approvedByEmployeeId], references: [id], onDelete: SetNull)
  archivedAt           DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([tenantCompanyId, employeeId])
  @@index([tenantCompanyId, leaveTypeId])
  @@index([tenantCompanyId, status])
  @@index([tenantCompanyId, startDate])
}

model StockMovement {
  id        String            @id @default(cuid())
  companyId String
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId String
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      StockMovementType
  quantity  Int
  reason    String
  reference String?
  note      String?
  createdAt DateTime          @default(now())

  @@index([companyId, productId])
  @@index([companyId, type])
  @@index([companyId, createdAt])
}

model InventoryWarehouse {
  id                 String                    @id @default(cuid())
  companyId          String
  company            Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code               String
  name               String
  description        String?
  active             Boolean                   @default(true)
  isDefault          Boolean                   @default(false)
  balances           InventoryBalance[]
  movementsFrom      InventoryStockMovement[]  @relation("InventoryMovementFromWarehouse")
  movementsTo        InventoryStockMovement[]  @relation("InventoryMovementToWarehouse")
  valuationEvents    InventoryValuationEvent[]
  goodsReceipts      ProcurementGoodsReceipt[]
  salesDeliveryNotes SalesDeliveryNote[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, active])
  @@index([companyId, isDefault])
}

model InventoryBalance {
  id                String             @id @default(cuid())
  companyId         String
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId         String
  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouseId       String
  warehouse         InventoryWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantityOnHand    Decimal            @default(0)
  quantityReserved  Decimal            @default(0)
  quantityAvailable Decimal            @default(0)
  reorderPoint      Decimal            @default(0)
  lastMovementDate  DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([companyId, productId, warehouseId])
  @@index([companyId])
  @@index([companyId, productId])
  @@index([companyId, warehouseId])
}

model InventoryStockMovement {
  id              String                   @id @default(cuid())
  companyId       String
  company         Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId       String

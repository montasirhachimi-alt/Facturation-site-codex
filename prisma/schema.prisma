  @@index([purchaseOrderLineId])
  @@index([productId])
}

model ProcurementSupplierBill {
  id                  String                        @id
  tenantCompanyId     String
  tenantCompany       Company                       @relation(fields: [tenantCompanyId], references: [id], onDelete: Cascade)
  workspaceId         String
  number              String
  supplierId          String
  supplier            ProcurementSupplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierName        String
  purchaseOrderId     String?
  purchaseOrder       ProcurementPurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  purchaseOrderNumber String?
  goodsReceiptId      String?
  goodsReceipt        ProcurementGoodsReceipt?      @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  goodsReceiptNumber  String?
  billDate            DateTime
  dueDate             DateTime?
  currency            String
  reference           String?
  notes               String?
  status              String
  discountRate        Float                         @default(0)
  accountedAt         DateTime?
  archivedAt          DateTime?
  ownerId             String?
  lines               ProcurementSupplierBillLine[]
  payments            ProcurementSupplierPayment[]
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  @@unique([tenantCompanyId, number])
  @@index([tenantCompanyId, workspaceId])
  @@index([tenantCompanyId, supplierId])
  @@index([tenantCompanyId, purchaseOrderId])
  @@index([tenantCompanyId, goodsReceiptId])
  @@index([tenantCompanyId, status])
}

model ProcurementSupplierBillLine {
  id                  String                  @id
  supplierBillId      String
  supplierBill        ProcurementSupplierBill @relation(fields: [supplierBillId], references: [id], onDelete: Cascade)
  purchaseOrderLineId String?
  goodsReceiptLineId  String?
  productId           String?
  product             Product?                @relation(fields: [productId], references: [id], onDelete: SetNull)
  productSku          String?
  productName         String?
  description         String
  quantity            Float
  unit                String
  unitPrice           Float
  discountRate        Float                   @default(0)
  taxRate             Float                   @default(0)
  position            Int

  @@index([supplierBillId])
  @@index([purchaseOrderLineId])
  @@index([goodsReceiptLineId])
  @@index([productId])
}

model ProcurementSupplierPayment {
  id                 String                  @id
  tenantCompanyId    String
  tenantCompany      Company                 @relation(fields: [tenantCompanyId], references: [id], onDelete: Cascade)
  workspaceId        String
  number             String
  supplierId         String
  supplier           ProcurementSupplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierName       String
  supplierBillId     String
  supplierBill       ProcurementSupplierBill @relation(fields: [supplierBillId], references: [id], onDelete: Restrict)
  supplierBillNumber String
  paymentDate        DateTime
  amount             Float
  currency           String
  method             String
  reference          String?
  notes              String?
  status             String
  finalizedAt        DateTime?
  accountedAt        DateTime?
  archivedAt         DateTime?
  ownerId            String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@unique([tenantCompanyId, number])
  @@index([tenantCompanyId, workspaceId])
  @@index([tenantCompanyId, supplierId])
  @@index([tenantCompanyId, supplierBillId])
  @@index([tenantCompanyId, status])
}

model AccountingAccount {
  id                           String                                @id
  tenantCompanyId              String
  tenantCompany                Company                               @relation(fields: [tenantCompanyId], references: [id], onDelete: Cascade)
  code                         String
  name                         String
  type                         String
  normalBalance                String
  parentAccountId              String?
  parentAccount                AccountingAccount?                    @relation("AccountingAccountHierarchy", fields: [parentAccountId], references: [id], onDelete: Restrict)
  childAccounts                AccountingAccount[]                   @relation("AccountingAccountHierarchy")
  currency                     String?
  active                       Boolean                               @default(true)
  archivedAt                   DateTime?
  createdBy                    String?
  updatedBy                    String?
  journalEntryLines            AccountingJournalEntryLine[]
  commercialReceivableSettings AccountingCommercialPostingSettings[] @relation("AccountingCommercialReceivableAccount")
  commercialRevenueSettings    AccountingCommercialPostingSettings[] @relation("AccountingCommercialRevenueAccount")
  commercialSettlementSettings AccountingCommercialPostingSettings[] @relation("AccountingCommercialSettlementAccount")
  commercialTaxSettings        AccountingCommercialPostingSettings[] @relation("AccountingCommercialTaxPayableAccount")
  apPayableSettings            AccountingApPostingSettings[]         @relation("AccountingApPayableAccount")
  apExpenseSettings            AccountingApPostingSettings[]         @relation("AccountingApExpenseAccount")
  apSettlementSettings         AccountingApPostingSettings[]         @relation("AccountingApSettlementAccount")
  apTaxRecoverableSettings     AccountingApPostingSettings[]         @relation("AccountingApTaxRecoverableAccount")
  inventoryAssetSettings       AccountingInventoryPostingSettings[]  @relation("AccountingInventoryAssetAccount")
  inventoryCogsSettings        AccountingInventoryPostingSettings[]  @relation("AccountingInventoryCogsAccount")
  inventoryGrniSettings        AccountingInventoryPostingSettings[]  @relation("AccountingInventoryGrniAccount")
  createdAt                    DateTime                              @default(now())
  updatedAt                    DateTime                              @updatedAt

  @@unique([tenantCompanyId, code])
  @@index([tenantCompanyId])
  @@index([tenantCompanyId, type])
  @@index([tenantCompanyId, active])
  @@index([parentAccountId])
}

model AccountingJournal {
  id                      String                                @id
  tenantCompanyId         String
  tenantCompany           Company                               @relation(fields: [tenantCompanyId], references: [id], onDelete: Cascade)
  code                    String
  name                    String
  type                    String
  active                  Boolean                               @default(true)
  archivedAt              DateTime?
  createdBy               String?
  updatedBy               String?
  entries                 AccountingJournalEntry[]
  commercialSalesSettings AccountingCommercialPostingSettings[] @relation("AccountingCommercialSalesJournal")
  apPurchaseSettings      AccountingApPostingSettings[]         @relation("AccountingApPurchaseJournal")
  inventorySettings       AccountingInventoryPostingSettings[]  @relation("AccountingInventoryJournal")
  createdAt               DateTime                              @default(now())
  updatedAt               DateTime                              @updatedAt

  @@unique([tenantCompanyId, code])
  @@index([tenantCompanyId])
  @@index([tenantCompanyId, type])
  @@index([tenantCompanyId, active])
}

model AccountingJournalEntry {
  id                  String                       @id
  tenantCompanyId     String
  tenantCompany       Company                      @relation(fields: [tenantCompanyId], references: [id], onDelete: Cascade)
  workspaceId         String
  journalId           String
  journal             AccountingJournal            @relation(fields: [journalId], references: [id], onDelete: Restrict)
  number              String
  entryDate           DateTime
  status              String
  description         String?
  reference           String?
  sourceType          String?
  sourceId            String?
  reversalOfEntryId   String?                      @unique
  reversalOfEntry     AccountingJournalEntry?      @relation("AccountingEntryReversal", fields: [reversalOfEntryId], references: [id], onDelete: Restrict)
  reversedByEntry     AccountingJournalEntry?      @relation("AccountingEntryReversal")
  correctedByEntryId  String?
  correctionReason    String?
  correctionType      String?
  functionalCurrency  String
  transactionCurrency String?
  exchangeRate        Decimal?
  debitTotal          Decimal                      @default(0)
  creditTotal         Decimal                      @default(0)
  postedAt            DateTime?
  postedBy            String?
  createdBy           String?
  updatedBy           String?
  lines               AccountingJournalEntryLine[]
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  @@unique([tenantCompanyId, number])
  @@unique([tenantCompanyId, sourceType, sourceId])
  @@index([tenantCompanyId, workspaceId])
  @@index([tenantCompanyId, journalId])
  @@index([tenantCompanyId, status])
  @@index([tenantCompanyId, entryDate])
  @@index([tenantCompanyId, sourceType, sourceId])
  @@index([tenantCompanyId, reversalOfEntryId])
  @@index([tenantCompanyId, correctionType])
}

model AccountingJournalEntryLine {
  id             String                 @id
  journalEntryId String
  journalEntry   AccountingJournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        AccountingAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  label          String
  debitAmount    Decimal                @default(0)
  creditAmount   Decimal                @default(0)
  position       Int
  metadata       Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([journalEntryId])
  @@index([accountId])
}

model AccountingCommercialPostingSettings {
  tenantCompanyId     String             @id
  tenantCompany       Company            @relation(fields: [tenantCompanyId], references: [id], onDelete: Cascade)
  salesJournalId      String?
  salesJournal        AccountingJournal? @relation("AccountingCommercialSalesJournal", fields: [salesJournalId], references: [id], onDelete: SetNull)
  receivableAccountId String?
  receivableAccount   AccountingAccount? @relation("AccountingCommercialReceivableAccount", fields: [receivableAccountId], references: [id], onDelete: SetNull)
  revenueAccountId    String?
  revenueAccount      AccountingAccount? @relation("AccountingCommercialRevenueAccount", fields: [revenueAccountId], references: [id], onDelete: SetNull)
  settlementAccountId String?
  settlementAccount   AccountingAccount? @relation("AccountingCommercialSettlementAccount", fields: [settlementAccountId], references: [id], onDelete: SetNull)
  taxPayableAccountId String?
  taxPayableAccount   AccountingAccount? @relation("AccountingCommercialTaxPayableAccount", fields: [taxPayableAccountId], references: [id], onDelete: SetNull)
  functionalCurrency  String             @default("MAD")
  updatedBy           String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([salesJournalId])
  @@index([receivableAccountId])
  @@index([revenueAccountId])
  @@index([settlementAccountId])
  @@index([taxPayableAccountId])
}

model AccountingApPostingSettings {
  tenantCompanyId         String             @id
  tenantCompany           Company            @relation(fields: [tenantCompanyId], references: [id], onDelete: Cascade)
  purchaseJournalId       String?
  purchaseJournal         AccountingJournal? @relation("AccountingApPurchaseJournal", fields: [purchaseJournalId], references: [id], onDelete: SetNull)
  payableAccountId        String?
  payableAccount          AccountingAccount? @relation("AccountingApPayableAccount", fields: [payableAccountId], references: [id], onDelete: SetNull)
  expenseAccountId        String?
  expenseAccount          AccountingAccount? @relation("AccountingApExpenseAccount", fields: [expenseAccountId], references: [id], onDelete: SetNull)
  settlementAccountId     String?
  settlementAccount       AccountingAccount? @relation("AccountingApSettlementAccount", fields: [settlementAccountId], references: [id], onDelete: SetNull)
  taxRecoverableAccountId String?
  taxRecoverableAccount   AccountingAccount? @relation("AccountingApTaxRecoverableAccount", fields: [taxRecoverableAccountId], references: [id], onDelete: SetNull)
  functionalCurrency      String             @default("MAD")
  updatedBy               String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([purchaseJournalId])
  @@index([payableAccountId])
  @@index([expenseAccountId])
  @@index([settlementAccountId])
  @@index([taxRecoverableAccountId])
}

model AccountingInventoryPostingSettings {
  tenantCompanyId         String             @id
  tenantCompany           Company            @relation(fields: [tenantCompanyId], references: [id], onDelete: Cascade)
  inventoryJournalId      String?
  inventoryJournal        AccountingJournal? @relation("AccountingInventoryJournal", fields: [inventoryJournalId], references: [id], onDelete: SetNull)
  inventoryAssetAccountId String?
  inventoryAssetAccount   AccountingAccount? @relation("AccountingInventoryAssetAccount", fields: [inventoryAssetAccountId], references: [id], onDelete: SetNull)
  cogsAccountId           String?
  cogsAccount             AccountingAccount? @relation("AccountingInventoryCogsAccount", fields: [cogsAccountId], references: [id], onDelete: SetNull)
  grniClearingAccountId   String?
  grniClearingAccount     AccountingAccount? @relation("AccountingInventoryGrniAccount", fields: [grniClearingAccountId], references: [id], onDelete: SetNull)
  functionalCurrency      String             @default("MAD")
  updatedBy               String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([inventoryJournalId])
  @@index([inventoryAssetAccountId])
  @@index([cogsAccountId])
  @@index([grniClearingAccountId])
}

model AccountingPeriod {
  id              String    @id
  tenantCompanyId String
  tenantCompany   Company   @relation(fields: [tenantCompanyId], references: [id], onDelete: Cascade)
  name            String
  startDate       DateTime
  endDate         DateTime
  status          String
  closedAt        DateTime?
  closedBy        String?
  reopenedAt      DateTime?
  reopenedBy      String?
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([tenantCompanyId, name])
  @@index([tenantCompanyId])
  @@index([tenantCompanyId, status])
  @@index([tenantCompanyId, startDate, endDate])
}
